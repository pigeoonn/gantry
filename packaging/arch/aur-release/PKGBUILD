# Maintainer: pigeoonn
# gantry: builds the tagged release of the public repository.
# Submit it with:  git clone ssh://aur@aur.archlinux.org/gantry.git  (then copy this file in, run makepkg --printsrcinfo > .SRCINFO)
pkgname=gantry
pkgver=5.3.0
pkgrel=1
pkgdesc='Mod, trainer and crash-hunting hub for Proton games on Linux'
arch=('x86_64')
url='https://github.com/pigeoonn/gantry'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'curl' 'xdg-utils' 'libarchive' 'wayland' 'libxkbcommon')
makedepends=('cargo')
optdepends=(
  'p7zip: install .7z and .rar mods'
  'unzip: fallback archive extraction'
  'gamemode: run games with gamemoderun'
  'mangohud: performance overlay'
  'libnotify: desktop notifications (notify-send)'
  'steam: sync launch options for Steam games'
  'chromium: app window for the interface (any Chromium based browser works)'
)
conflicts=('gantry-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f08c71b02c586e74fb3aba2c065cbd870ca5d890aad800de11b56e470acae2ef')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/rig "$pkgdir/usr/bin/rig"
  install -Dm644 packaging/gantry.desktop "$pkgdir/usr/share/applications/gantry.desktop"
  install -Dm644 src/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/gantry.png"
  install -Dm644 src/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/gantry.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/GUIDE.md "$pkgdir/usr/share/doc/$pkgname/GUIDE.md"
  install -Dm644 docs/INSTALL.md "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
}
